{
  // Engine debugger (tools/vscode-pioscope, docs/debugging.md).
  // Step Over = one instruction, Step Into = one sysclk cycle, Step Out = finish it.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pioscope",
      "request": "launch",
      "name": "Debug current program",
      "program": "${file}",
      "devices": ["uart_partner"],
      "baud": 115200,
      "hostTx": ["0x55", "0xA3"],
      "uartSend": ["0x55", "0xA3"],
      "vcd": "${workspaceFolder}/build/debug.vcd",
      "stopOnEntry": true
    },
    {
      "type": "pioscope",
      "request": "launch",
      "name": "PIO: UART RX scenario",
      "scenario": "sim.packs.pio.tests.scenarios:uart_rx",
      "vcd": "${workspaceFolder}/build/debug_rx.vcd",
      "stopOnEntry": true
    },
    {
      "type": "pioscope",
      "request": "launch",
      "name": "PIO: UART TX",
      "program": "${workspaceFolder}/sim/packs/pio/programs/uart_tx.pio",
      "devices": ["uart_partner"],
      "hostTx": ["0x55", "0xA3"],
      "baud": 115200,
      "vcd": "${workspaceFolder}/build/debug.vcd",
      "stopOnEntry": true
    },
    {
      "type": "pioscope",
      "request": "launch",
      "name": "PIO: SPI mode 0 scenario",
      "scenario": "sim.packs.pio.tests.scenarios:spi_master",
      "vcd": "${workspaceFolder}/build/debug_spi.vcd",
      "stopOnEntry": true
    },
    {
      "type": "pioscope",
      "request": "launch",
      "name": "Blink with an edge-counting unit (tutorial 04)",
      "scenario": "sim.examples.pulse_counter:blink_scenario",
      "dut": "sim.examples.edge_counter:EdgeCountingEngine",
      "vcd": "${workspaceFolder}/build/debug.vcd",
      "stopOnEntry": true
    }
  ]
}
