{
  // Engine debugger (piolab/vscode, docs/debugging.md).
  // Step Over = one instruction, Step Into = one sysclk cycle, Step Out = finish it.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "piolab",
      "request": "launch",
      "name": "Debug current program",
      "program": "${file}",
      "devices": ["uart:baud=115200,send=0x55,0xA3"],
      "hostTx": ["0x55", "0xA3"],
      "vcd": "${workspaceFolder}/build/debug.vcd",
      "stopOnEntry": true
    },
    {
      "type": "piolab",
      "request": "launch",
      "name": "PIO: UART RX scenario",
      "scenario": "uart_rx",
      "vcd": "${workspaceFolder}/build/debug_rx.vcd",
      "stopOnEntry": true
    },
    {
      "type": "piolab",
      "request": "launch",
      "name": "PIO: UART TX",
      "program": "${workspaceFolder}/piolab/packs/pio/programs/uart_tx.pio",
      "devices": ["uart:baud=115200"],
      "hostTx": ["0x55", "0xA3"],
      "vcd": "${workspaceFolder}/build/debug.vcd",
      "stopOnEntry": true
    },
    {
      "type": "piolab",
      "request": "launch",
      "name": "PIO: SPI mode 0 scenario",
      "scenario": "spi_master",
      "vcd": "${workspaceFolder}/build/debug_spi.vcd",
      "stopOnEntry": true
    },
    {
      "type": "piolab",
      "request": "launch",
      "name": "Blink with an edge-counting unit (tutorial 04)",
      "scenario": "piolab.examples.pulse_counter:blink_scenario",
      "dut": "piolab.examples.edge_counter:EdgeCountingEngine",
      "vcd": "${workspaceFolder}/build/debug.vcd",
      "stopOnEntry": true
    }
  ]
}
