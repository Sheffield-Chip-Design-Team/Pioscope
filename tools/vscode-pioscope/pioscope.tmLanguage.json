{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PIOScope assembly",
  "scopeName": "source.pioscope-asm",
  "comment": "Generated by tools/vscode-pioscope/build.py from the ISA packs' yaml (spec/isa/*.yaml). Do not edit.",
  "patterns": [
    {
      "name": "comment.line.semicolon.pioscope-asm",
      "match": ";.*$"
    },
    {
      "name": "comment.line.double-slash.pioscope-asm",
      "match": "//.*$"
    },
    {
      "name": "entity.name.function.label.pioscope-asm",
      "match": "^\\s*[A-Za-z_]\\w*(?=:)"
    },
    {
      "name": "keyword.control.directive.pioscope-asm",
      "match": "(?<![\\w.])(?:\\.wrap_target|\\.sm_config|\\.side_set|\\.program|\\.clkdiv|\\.define|\\.pins|\\.wrap)\\b"
    },
    {
      "name": "keyword.other.instruction.pioscope-asm",
      "match": "(?<![\\w.])(?:pull|push|wait|irq|jmp|mov|nop|out|set|in)(?![\\w.])"
    },
    {
      "name": "constant.numeric.pioscope-asm",
      "match": "\\b(?:0x[0-9A-Fa-f_]+|0b[01_]+|\\d+(?:\\.\\d+)?[kM]?(?:x\\d+)?)\\b"
    },
    {
      "name": "variable.parameter.option.pioscope-asm",
      "match": "\\b[A-Za-z_]\\w*(?==)"
    },
    {
      "name": "support.constant.condition.pioscope-asm",
      "match": "(?:!(?:x|y|osre)|x--|y--|x!=y|\\b(?:always|pin)\\b)"
    },
    {
      "name": "storage.modifier.delay.pioscope-asm",
      "match": "\\[[^\\]]*\\]"
    },
    {
      "name": "support.type.keyword.pioscope-asm",
      "match": "\\b(?:ifempty|noblock|pindirs|iffull|nowait|status|block|clear|right|exec|gpio|left|null|pins|side|isr|opt|osr|rel|pc|rx|tx|x|y)\\b"
    }
  ]
}
